# CyberRisk Quant Platform — backend environment
# Copy this file to `.env` and adjust. NEVER commit a real .env with secrets.

APP_ENV=development

# Database — any SQLAlchemy URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./cyberrisk.db

# Token signing key. CHANGE THIS to a long random string for any real deployment.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12

# Comma-separated CORS origins (Vite dev server + preview build).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional LLM rephrasing for the assistant. Financial numbers ALWAYS come from
# the computed model — the LLM (if enabled) only rewords the deterministic answer.
LLM_ENABLED=false
LLM_API_KEY=

# Safe file-import limits (bytes).
MAX_UPLOAD_BYTES=10485760
